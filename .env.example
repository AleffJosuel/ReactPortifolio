# Reference of every env var used across the monorepo. Actual values go in
# backend/.env (used by ./mvnw / your IDE run config) and frontend/.env
# (used by Vite) -- see each folder's own .env.example.

# --- backend/.env ---
DB_HOST=db.xxxxxxxxxxxx.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=portfolio_app
DB_PASSWORD=change-me
GITHUB_USERNAME=AleffJosuel
GITHUB_CACHE_TTL_MINUTES=15
ADMIN_TOKEN=choose-a-long-random-secret
CORS_ALLOWED_ORIGINS=http://localhost:5173
PORT=8080

# --- frontend/.env ---
VITE_API_BASE_URL=http://localhost:8080
